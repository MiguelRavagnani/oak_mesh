[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../third_party/oak_mesh/oak_mesh/target/debug/libgodot_wrapper.so"
linux.release.x86_64 =     "res://../third_party/oak_mesh/oak_mesh/target/release/libgodot_wrapper.so"
windows.debug.x86_64 =   "res://../third_party/oak_mesh/oak_mesh/target/x86_64-pc-windows-gnu/debug/godot_wrapper.dll"
windows.release.x86_64 =   "res://../third_party/oak_mesh/oak_mesh/target/x86_64-pc-windows-gnu/release/godot_wrapper.dll"